<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#F5F7FA"
    tools:context=".Disciplinas">
    <Button
        android:id="@+id/btnVoltar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VOLTAR"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Disciplinas"
        android:textColor="#FF5722"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/btnVoltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="25dp"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Programação"
            android:id="@+id/programacao"
            android:clickable="true" android:focusable="true" android:minHeight="48dp" android:background="?attr/selectableItemBackground"
            android:textColor="#333333"
            android:textSize="20sp"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Banco de Dados"
            android:id="@+id/bancoDados"
            android:clickable="true" android:focusable="true" android:minHeight="48dp" android:background="?attr/selectableItemBackground"
            android:textColor="#333333"
            android:textSize="20sp"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Engenharia de Software"
            android:id="@+id/engenhariaSoftware"
            android:clickable="true" android:focusable="true" android:minHeight="48dp" android:background="?attr/selectableItemBackground"
            android:textColor="#333333"
            android:textSize="20sp"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Desenvolvimento Web"
            android:id="@+id/desenvolvimentoWeb"
            android:clickable="true" android:focusable="true" android:minHeight="48dp" android:background="?attr/selectableItemBackground"
            android:textColor="#333333"
            android:textSize="20sp"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Desenvolvimento Mobile"
            android:id="@+id/desenvolvimentoMobile"
            android:clickable="true" android:focusable="true" android:minHeight="48dp" android:background="?attr/selectableItemBackground"
            android:textColor="#333333"
            android:textSize="20sp"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Inteligência Artificial"
            android:id="@+id/inteligenciaArtificial"
            android:clickable="true" android:focusable="true" android:minHeight="48dp" android:background="?attr/selectableItemBackground"
            android:textColor="#333333"
            android:textSize="20sp"
            android:padding="12dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
